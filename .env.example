APP_NAME=career-copilot
APP_ENV=local
APP_DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

DEV_AUTH_ENABLED=false
DEV_USER_EMAIL=dev@local.test

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_PASSWORD_RESET_LIMIT=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=300
RATE_LIMIT_UPLOAD_LIMIT=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=300

STORAGE_MODE=minio
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,application/octet-stream

CORS_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Trusted Host header allowlist. "*" (default) disables TrustedHostMiddleware.
# In production set to the real hosts, e.g. "api.example.com".
ALLOWED_HOSTS=*

DATABASE_URL=postgresql+psycopg://career_user:career_pass@localhost:5432/career_copilot
SYNC_DATABASE_URL=postgresql+psycopg://career_user:career_pass@localhost:5432/career_copilot
TEST_DATABASE_URL=postgresql+psycopg://career_user:career_pass@localhost:5432/career_copilot_test

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me-local
MINIO_SECRET_KEY=change-me-local
MINIO_BUCKET=career-copilot
MINIO_SECURE=false
# In production MINIO_SECURE must be true (TLS to object storage).

SENTRY_DSN=
OPENAI_API_KEY=

JWT_SECRET_KEY=change-this-to-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Field-level encryption (ФЗ-152). One or more comma-separated Fernet keys.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In production this MUST be set to real keys (a default/empty value is rejected).
FIELD_ENCRYPTION_KEYS=

AI_PROVIDER=gigachat
AI_DEFAULT_MODEL=gigachat-pro
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.1
# Cost accounting (ТЗ §3.4): стоимость за 1000 токенов. 0 — учёт отключён.
AI_COST_PER_1K_INPUT=0
AI_COST_PER_1K_OUTPUT=0
# AI response cache (ТЗ §3.4). По умолчанию выключен.
AI_CACHE_ENABLED=false
AI_CACHE_MAX_SIZE=256

# Для локального mock/demo:
# AI_PROVIDER=mock
# AI_DEFAULT_MODEL=mock-model

GIGACHAT_API_KEY=
GIGACHAT_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30
HH_USER_AGENT=career-copilot/0.1 your-email@example.com

# OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# Billing (ТЗ §3.5). Stripe official SDK. Empty by default — required in production.
# stripe_secret_key: sk_live_* / sk_test_* ; stripe_webhook_secret: whsec_* (from Stripe Dashboard → Webhooks).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
# Price ID of the paid monthly plan (Stripe Dashboard → Products → price_xxx).
STRIPE_PRICE_PAID_MONTHLY_ID=
# Display-only amount in minor units (cents) for the paid monthly plan.
STRIPE_PAID_MONTHLY_AMOUNT=0
STRIPE_PAID_PLAN_NAME=paid_monthly
# Free-tier usage quotas (rolling window = BILLING_QUOTA_WINDOW_DAYS).
# paid_monthly = unlimited (limits not applied). Set high in tests.
BILLING_FREE_TIER_AI_REQUESTS_LIMIT=50
BILLING_FREE_TIER_DOC_UPLOADS_LIMIT=10
BILLING_FREE_TIER_GENERATED_OUTPUTS_LIMIT=5
BILLING_QUOTA_WINDOW_DAYS=30
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
BILLING_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
BILLING_PORTAL_RETURN_URL=http://localhost:3000/billing
