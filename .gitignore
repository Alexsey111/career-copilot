# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Env
.env
.env.local

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Alembic / logs
*.log

# Frontend
frontend/node_modules/
frontend/.next/

# Uploaded / local data
data/*
!data/.gitkeep
tmp/
infra/docker/import_resume.json

# Локальные тестовые артефакты (вакансии/резюме) и персональная memory —
# не часть кодовой базы.
111/
memory/

# Диагностические артефакты Claude-сессий (.diag_*.txt/.py, .tok.txt и т.п.)
# — это разовые дампы для отладки, не для репозитория.
.diag_*.txt
.diag_*.py
tools/diag_*.py
.tok.txt
.claude/

# Скриншоты прошлых сессий (redo-*, resume-history-*) — локальная история визуальных
# ревью, новые скришоты для коммитов добавляются явно через `git add`.
tools/shots/redo-*
tools/shots/resume-history-*
